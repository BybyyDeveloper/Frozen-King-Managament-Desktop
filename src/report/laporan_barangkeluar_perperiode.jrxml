	<parameter name="tgl1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    barang_keluar.no_keluar AS barang_keluar_no_keluar,
    barang_keluar.tgl_keluar AS barang_keluar_tgl_keluar,
    barang_keluar.total_keluar AS barang_keluar_total_keluar
FROM
    barang_keluar barang_keluar
WHERE 
   tgl_keluar BETWEEN $P{tgl1} AND $P{tgl2}]]>
	</queryString>
	<field name="barang_keluar_no_keluar" class="java.lang.String"/>
	<field name="barang_keluar_tgl_keluar" class="java.sql.Date"/>
	<field name="barang_keluar_total_keluar" class="java.lang.Double"/>
	<variable name="TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{barang_keluar_total_keluar}]]></variableExpression>
	</variable>
