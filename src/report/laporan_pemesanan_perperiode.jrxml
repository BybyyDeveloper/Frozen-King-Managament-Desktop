	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="194"/>
	<property name="ireport.y" value="126"/>
	<parameter name="tgl1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
   pemesanan.tgl_pesan AS  pemesanan_tgl_pesan,
   pemesanan.total_pesan AS pemesanan_total_pesan,
   supplier.id_supplier AS supplier_id_supplier,
   supplier.nama_supplier AS supplier_nama_supplier,
   pemesanan.no_pesan AS pemesanan_no_pesan
FROM
   pemesanan pemesanan INNER JOIN supplier supplier ON pemesanan.id_supplier = supplier.id_supplier
WHERE 
   tgl_pesan BETWEEN $P{tgl1} and $P{tgl2}]]>
	</queryString>
	<field name="pemesanan_tgl_pesan" class="java.lang.String"/>
	<field name="pemesanan_total_pesan" class="java.lang.Integer"/>
	<field name="supplier_id_supplier" class="java.lang.String"/>
	<field name="supplier_nama_supplier" class="java.lang.String"/>
	<field name="pemesanan_no_pesan" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pemesanan_total_pesan}]]></variableExpression>
	</variable>
