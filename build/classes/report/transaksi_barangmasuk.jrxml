	<property name="ireport.y" value="281"/>
	<parameter name="no" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    barang_masuk.tgl_masuk AS barang_masuk_tgl_masuk,
    barang_masuk.total_masuk AS barang_masuk_total_masuk,
    detail_barang_masuk.no_masuk AS detail_barang_masuk_no_masuk,
    detail_barang_masuk.kode_barang AS detail_barang_masuk_kode_barang,
    detail_barang_masuk.jml_masuk AS detail_barang_masuk_jml_masuk,
    detail_barang_masuk.subtotal_masuk AS detail_barang_masuk_subtotal_masuk,
    barang.nama_barang AS barang_nama_barang,
    barang.satuan AS barang_satuan,
    barang.harga AS barang_harga,
    supplier.nama_supplier AS supplier_nama_supplier,
    supplier.alamat_supplier AS supplier_alamat_supplier
FROM
    barang_masuk barang_masuk
INNER JOIN
    detail_barang_masuk detail_barang_masuk ON barang_masuk.no_masuk = detail_barang_masuk.no_masuk
INNER JOIN
    barang barang ON detail_barang_masuk.kode_barang = barang.kode_barang
INNER JOIN
    supplier supplier ON barang_masuk.id_supplier = supplier.id_supplier
WHERE
    detail_barang_masuk.no_masuk=$P{no}]]>
	</queryString>
