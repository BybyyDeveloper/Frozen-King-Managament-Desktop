	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="504"/>
	<property name="ireport.y" value="772"/>
	<parameter name="no" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    pemesanan.tgl_pesan AS pemesanan_tgl_pesan,
    pemesanan.total_pesan AS pemesanan_total_pesan,
    detail_pemesanan.no_pesan AS detail_pemesanan_no_pesan,
    detail_pemesanan.kode_barang AS detail_pemesanan_kode_barang,
    detail_pemesanan.jml_pesan AS detail_pemesanan_jml_pesan,
    detail_pemesanan.subtotal_pesan AS detail_pemesanan_subtotal_pesan,
    barang.nama_barang AS barang_nama_barang,
    barang.satuan AS barang_satuan,
    barang.harga AS barang_harga,
    supplier.nama_supplier AS supplier_nama_supplier,
    supplier.alamat_supplier AS supplier_alamat_supplier,
    detail_pemesanan.status AS detail_pemesanan_status 
FROM
    pemesanan 
INNER JOIN
    detail_pemesanan ON pemesanan.no_pesan = detail_pemesanan.no_pesan 
INNER JOIN
    barang ON detail_pemesanan.kode_barang = barang.kode_barang 
INNER JOIN
    supplier ON pemesanan.id_supplier = supplier.id_supplier 
WHERE
    detail_pemesanan.no_pesan = $P{no}]]>
	</queryString>
	<field name="pemesanan_tgl_pesan" class="java.util.Date"/>
	<field name="pemesanan_total_pesan" class="java.lang.Integer"/>
	<field name="detail_pemesanan_no_pesan" class="java.lang.String"/>
	<field name="detail_pemesanan_kode_barang" class="java.lang.String"/>
	<field name="detail_pemesanan_jml_pesan" class="java.lang.Integer"/>
