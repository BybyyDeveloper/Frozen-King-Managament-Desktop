	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tgl1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
   barang_masuk.tgl_masuk AS barang_masuk_tgl_masuk,
   barang_masuk.total_masuk AS barang_masuk_total_masuk,
   supplier.id_supplier AS supplier_id_supplier,
   supplier.nama_supplier AS supplier_nama_supplier,
   barang_masuk.no_masuk AS barang_masuk_no_masuk
FROM
   barang_masuk barang_masuk INNER JOIN supplier supplier ON barang_masuk.id_supplier = supplier.id_supplier
WHERE 
   tgl_masuk BETWEEN $P{tgl1} AND $P{tgl2}]]>
	</queryString>
	<field name="barang_masuk_tgl_masuk" class="java.sql.Date"/>
	<field name="barang_masuk_total_masuk" class="java.lang.Double"/>
	<field name="supplier_id_supplier" class="java.lang.String"/>
	<field name="supplier_nama_supplier" class="java.lang.String"/>
	<field name="barang_masuk_no_masuk" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Double">
		<variableExpression><![CDATA[$F{barang_masuk_total_masuk}]]></variableExpression>
	</variable>
