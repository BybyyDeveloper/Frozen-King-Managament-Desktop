	<property name="ireport.y" value="48"/>
	<parameter name="no" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    detail_penjualan.no_penjualan AS detail_penjualan_no_penjualan,
    detail_penjualan.kode_barang AS detail_penjualan_kode_barang,
    detail_penjualan.jml_jual AS detail_penjualan_jml_jual,
    detail_penjualan.subtotal_jual AS detail_penjualan_subtotal_jual,
    penjualan.tgl_jual AS penjualan_tgl_jual,
    penjualan.total_jual AS penjualan_total_jual,
    barang.kode_barang AS barang_kode_barang,
    barang.nama_barang AS barang_nama_barang,
    barang.satuan AS barang_satuan,
    barang.harga AS barang_harga
FROM
   penjualan penjualan
INNER JOIN
    detail_penjualan detail_penjualan ON penjualan.no_jual = detail_penjualan.no_penjualan
INNER JOIN
    barang barang ON detail_penjualan.kode_barang = barang.kode_barang
WHERE 
    detail_penjualan.no_penjualan=$P{no};]]>
	</queryString>
